# Variable names only. Copy to .env.local and paste the values Moses shares through the password manager.
# Never put a real value in this file (the repo is public).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server and Edge Functions only, never the browser

# App URL, for deal-link QR codes and the sign-in redirect (e.g. the Vercel URL)
NEXT_PUBLIC_SITE_URL=

# Map
NEXT_PUBLIC_MAPBOX_TOKEN=

# Errors
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                # build-time source map upload only

# Stretch goal: push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Stretch goal: email
RESEND_API_KEY=
