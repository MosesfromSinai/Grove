# Variable names only. Copy to .env.local and fill in what you need (see README → Getting started).
# Never put a real value in this file (the repo is public).

# Supabase: copy the URL and anon key from the dashboard (grove-dev → Project Settings → API Keys → Legacy)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Data source for screens: mocks (default) or supabase (needs RLS policies, #128)
NEXT_PUBLIC_DATA_SOURCE=
SUPABASE_SERVICE_ROLE_KEY=        # Moses only; teammates leave this empty. Server and Edge Functions, never the browser

# App URL, for deal-link QR codes and the sign-in redirect. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Map: Hikaru creates the token; get it from Moses by one-time link
NEXT_PUBLIC_MAPBOX_TOKEN=

# Errors
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                # build-time source map upload only

# Stretch goal: push notifications
NEXT_PUBLIC_PUSH_ENABLED=         # false until Moses approves the rollout
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Supabase Edge Function secrets only, not Vercel public variables
VAPID_PUBLIC_KEY=                 # same public key as the client
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                    # https origin or mailto contact
PUSH_DISPATCH_SECRET=             # random server-only cron credential
PUSH_SEND_ENABLED=                # false until migrations and test recipients are ready

# Stretch goal: email
RESEND_API_KEY=
